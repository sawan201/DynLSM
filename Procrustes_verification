import numpy as np
from scipy.linalg import orthogonal_procrustes
np.random.seed(0)
T, n, p = 4, 10, 2
X0 = np.random.randn(T * n, p)

# make a ground-truth orthogonal rotation Q_true
A = np.random.randn(p, p)
Q_true, _ = np.linalg.qr(A)  # QR decomp to get orthogonal matrix

# MCMC might return X instead of X0 when running
X = X0 @ Q_true   

R_hat, _ = orthogonal_procrustes(X, X0)   # 

# checks
rot_err   = np.linalg.norm(R_hat - Q_true.T, ord="fro")
resid_rel = np.linalg.norm(X @ R_hat - X0, ord="fro") / np.linalg.norm(X0, ord="fro")
orth_err  = np.linalg.norm(R_hat.T @ R_hat - np.eye(p), ord="fro")
detR      = np.linalg.det(R_hat)

print("rot_err (||R_hat - Q_true^T||_F):", rot_err)
print("relative_residual (||X R_hat - X0||_F / ||X0||_F):", resid_rel)
print("orthogonality_error (||R^T R - I||_F):", orth_err)
print("det(R_hat):", detR)

# outputs are zero so the procrustes recovered transform.
